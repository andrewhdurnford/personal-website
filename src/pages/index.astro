---
import Layout from '../layouts/Layout.astro';
import '@fontsource/lilex';
import '../globals.css';
import Analytics from '@vercel/analytics/astro'
---

<Layout title="Andrew Durnford">
    <main>
        <h2><span id="typed-name"></span><span class="cursor"></span></h2>
        <div class="about">
      CS & Ivey Business Student at Western University, building Full Stack software. 
      Experience building consumer applications, healthcare billing services, predictive analytics systems, and internal developer tools.
        </div>
        <h2>Experience</h2>
        <ul class="experience">
            <li>
                <span class="experience-title">
                  <a href="https://pointclickcare.com/" target="_blank">PointClickCare</a>
                   — Software Engineering Intern (Product)</span>
                <span class="experience-date">May 2026 - Aug 2026</span>
            </li>
            <li>
                <span class="experience-title">
                  <a href="https://pointclickcare.com/" target="_blank">PointClickCare</a>
                   — Software Engineering Intern (Platform)</span>
                <span class="experience-date">May 2025 - Aug 2025</span>
            </li>
            <li>
                <span class="experience-title">
                  <a href="https://www.planinternational.org/" target="_blank">Plan International</a>
                   — Software Engineer (Pro Bono)</span>
                <span class="experience-date">Sep 2025 - Apr 2026</span>
            </li>
            <li>
                <span class="experience-title">
                  <a href="https://github.com/TenacityLabs" target="_blank">Tenacity Labs</a>
                   — Software Engineer</span>
                <span class="experience-date">Apr 2024 - May 2025</span>
            </li>
        </ul>
        <h2>Projects</h2>
        <ul class="projects">
            <li>
                <a href="https://github.com/andrewhdurnford/sunflower-nextjs" target="_blank">
                <span>Sunflower Capital — Landing page built with Next.js</span>
                </a>
            </li>
            <li>
                <a href="https://spotify.andrewdurnford.com" target="_blank">
                <span>Spotify Tracker — Next.js/FastAPI spotify stat tracker</span>
                </a>
            </li>
            <li>
                <a href="https://zetamac.andrewdurnford.com" target="_blank">
                <span>Zetamac — Mental math practice game</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/andrewhdurnford/valPRED" target="_blank">
                <span>ValPRED — Valorant professional match predictor using Python, Pandas, Sklearn</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/TenacityLabs/unfollowed.lol" target="_blank">
                <span>Unfollowed.lol — Chrome extension tracking Instagram followers & unfollowers</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/TenacityLabs/retrospect-frontend" target="_blank">
                <span>Retrospect Mobile App — Swift mobile app to create and share time capsules</span>
                </a>
            </li>
        </ul>
    </main>
    <div class="links">
        <a class="textLink" href="https://github.com/andrewhdurnford" target="_blank">GitHub</a>
        <span class="dot">•</span>
        <a class="textLink" href="https://www.linkedin.com/in/durnford/" target="_blank">LinkedIn</a>
        <span class="dot">•</span>
        <a class="textLink" href="mailto:andrewhdurnford@gmail.com" target="_blank">Email</a>
        <span class="dot">•</span>
        <a class="textLink" href="./resume.pdf" target="_blank">Resume</a>
    </div>
  <Analytics />
</Layout>

<script>
	const nameEl = document.getElementById('typed-name') as HTMLElement;
	const fullName = 'Andrew Durnford. ';
	let i = 0;
	function typeName() {
		if (i <= fullName.length) {
			nameEl.textContent = fullName.slice(0, i);
			i++;
			setTimeout(typeName, 110 + Math.random() * 80);
		}
	}
	typeName();
</script>

<style>
    main {
        margin: auto 0;
        padding: 1rem;
        padding-bottom: 6rem;
        width: 700px;
        max-width: calc(100% - 4rem);
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }
  
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0.02;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' /%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' /%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* headings and content styles */
    h2 {
        font-family: "Lilex";
        font-weight: 400;
        font-size: 1.5rem;
    }

    body:not(.crt-text-off) main h2:not(:first-of-type)::before {
        content: "> ";
        color: #63727a;
    }

    body.crt-text-off .cursor {
        display: none;
    }

    .cursor {
        display: inline-block;
        width: 0.55em;
        height: 1.1em;
        margin-left: 0.15em;
        background: #F4F4F9;
        vertical-align: -0.15em;
        box-shadow:
            0 0 0.4em rgba(244, 244, 249, 0.6),
            3px 0 6px rgba(255, 0, 255, 0.35),
            -3px 0 6px rgba(0, 255, 255, 0.35);
        animation: cursor-blink 1s steps(1) infinite;
    }

    @keyframes cursor-blink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
    }

    .about {
        font-family: "Lilex";
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.75;
        color: #F4F4F9;
        text-align: justify;
    }

  @media (max-width: 480px) {
    .about {
      text-align: left;
    }
  }

    .links {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 0.75rem;
        padding-bottom: 1.5rem;
        height: 7rem;
        background: linear-gradient(to bottom, transparent, #001A23 65%);
        z-index: 1;
    }

    .dot {
        color: #D1D1D7;
        font-size: 0.7rem;
    }

    a:link, a:visited {
        color: #F4F4F9;
        text-decoration: none;
    }

    a:hover, a:active {
        color: white;
        text-decoration: underline;
    }

    .textLink {
        font-family: "Lilex";
        font-size: 0.85rem;
        font-weight: 300;
    }

    ul {
        margin: 0 auto;
        padding: 0;
        list-style-type: none;
      }
    
    li {
        font-family: "Lilex";
        font-size: 0.85rem;
        font-weight: 300;
        color: #F4F4F9;
        transition: transform 0.25s;
        text-decoration: none;
        line-height: 2;
    }

    .experience {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .experience li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }


    .experience-title {
        color: #F4F4F9;
    }

    .experience-date {
        font-weight: 300;
        color: #D1D1D7;
        font-style: italic;
    }
</style>
