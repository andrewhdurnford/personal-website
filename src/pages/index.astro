---
import Layout from '../layouts/Layout.astro';
import '@fontsource/lilex';
import Analytics from '@vercel/analytics/astro'
---

<Layout title="Andrew Durnford">
    <main>
        <h2><span id="typed-name"></span><span class="cursor"></span></h2>
        <div class="links">
            <a class="textLink" href="https://github.com/andrewhdurnford" target="_blank">GitHub</a>
            <span class="dot">/</span>
            <a class="textLink" href="https://www.linkedin.com/in/durnford/" target="_blank">LinkedIn</a>
            <span class="dot">/</span>
            <a class="textLink" href="mailto:andrewhdurnford@gmail.com" target="_blank">Email</a>
            <span class="dot">/</span>
            <a class="textLink" href="./resume.pdf" target="_blank">Resume</a>
        </div>
        <h2 data-cat="about.txt">About</h2>
        <div class="about">
      CS & Ivey Business Student at Western University, building Full Stack software.
      Experience building consumer applications, healthcare billing services, predictive analytics systems, and internal developer tools.
        </div>
        <h2 data-cat="experience.txt">Experience</h2>
        <ul class="experience">
            <li>
                <span class="experience-title">
                  <a class="experience-company" href="https://pointclickcare.com/" target="_blank">PointClickCare</a><span class="experience-dash"> — </span><span class="experience-role">Software Engineering Intern (Product)</span></span>
                <span class="experience-date">May 2026 - Aug 2026</span>
            </li>
            <li>
                <span class="experience-title">
                  <a class="experience-company" href="https://pointclickcare.com/" target="_blank">PointClickCare</a><span class="experience-dash"> — </span><span class="experience-role">Software Engineering Intern (Platform)</span></span>
                <span class="experience-date">May 2025 - Aug 2025</span>
            </li>
            <li>
                <span class="experience-title">
                  <a class="experience-company" href="https://www.planinternational.org/" target="_blank">Plan International</a><span class="experience-dash"> — </span><span class="experience-role">Software Engineer (Pro Bono)</span></span>
                <span class="experience-date">Sep 2025 - Apr 2026</span>
            </li>
            <li>
                <span class="experience-title">
                  <a class="experience-company" href="https://github.com/TenacityLabs" target="_blank">Tenacity Labs</a><span class="experience-dash"> — </span><span class="experience-role">Software Engineer</span></span>
                <span class="experience-date">Apr 2024 - May 2025</span>
            </li>
        </ul>
        <h2 data-cat="projects.txt">Projects</h2>
        <ul class="projects">
            <li>
                <a href="https://github.com/andrewhdurnford/sunflower-nextjs" target="_blank">
                <span class="project-name">Sunflower Capital</span><span class="project-dash"> — </span><span class="project-desc">Landing page built with Next.js</span>
                </a>
            </li>
            <li>
                <a href="https://spotify.andrewdurnford.com" target="_blank">
                <span class="project-name">Spotify Tracker</span><span class="project-dash"> — </span><span class="project-desc">Next.js/FastAPI spotify stat tracker</span>
                </a>
            </li>
            <li>
                <a href="https://zetamac.andrewdurnford.com" target="_blank">
                <span class="project-name">Zetamac</span><span class="project-dash"> — </span><span class="project-desc">Mental math practice game</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/andrewhdurnford/valPRED" target="_blank">
                <span class="project-name">ValPRED</span><span class="project-dash"> — </span><span class="project-desc">Valorant professional match predictor using Python, Pandas, Sklearn</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/TenacityLabs/unfollowed.lol" target="_blank">
                <span class="project-name">Unfollowed.lol</span><span class="project-dash"> — </span><span class="project-desc">Chrome extension tracking Instagram followers & unfollowers</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/TenacityLabs/retrospect-frontend" target="_blank">
                <span class="project-name">Retrospect Mobile App</span><span class="project-dash"> — </span><span class="project-desc">Swift mobile app to create and share time capsules</span>
                </a>
            </li>
        </ul>
    </main>
  <Analytics />
</Layout>

<script>
	const nameEl = document.getElementById('typed-name') as HTMLElement;
	const cursorEl = document.querySelector('.cursor') as HTMLElement;
	const fullName = 'Andrew Durnford ';
	let i = 0;
	function typeName() {
		if (i <= fullName.length) {
			nameEl.textContent = fullName.slice(0, i);
			i++;
			setTimeout(typeName, 80 + Math.random() * 40);
		} else {
			setTimeout(() => cursorEl.classList.add('cursor-done'), 3000);
		}
	}
	typeName();
</script>

<style>
    main {
        margin: auto 0;
        padding: 1rem;
        width: 700px;
        max-width: calc(100% - 4rem);
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }
  
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0.02;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' /%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' /%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* headings and content styles */
    h2 {
        font-family: "Lilex";
        font-weight: 400;
        font-size: 1.5rem;
    }

    body:not(.crt-text-off) main h2:not(:first-of-type) {
        font-size: 0;
        margin: 0.83rem 0;
    }

    body:not(.crt-text-off) main h2:not(:first-of-type)::before {
        content: "$ cat " attr(data-cat);
        display: block;
        font-size: 0.85rem;
        line-height: normal;
        color: #63727a;
    }

    body.crt-text-off main h2:not(:first-of-type) {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    body.crt-text-off .cursor {
        display: none;
    }

    .cursor {
        display: inline-block;
        width: 0.55em;
        height: 1.1em;
        margin-left: 0.15em;
        background: #F4F4F9;
        vertical-align: -0.15em;
        box-shadow:
            0 0 0.4em rgba(244, 244, 249, 0.6),
            3px 0 6px rgba(255, 0, 255, 0.35),
            -3px 0 6px rgba(0, 255, 255, 0.35);
        animation: cursor-blink 1s steps(1) 6 forwards;
        transition: opacity 0.5s;
    }

    .cursor.cursor-done {
        animation: none;
        opacity: 0;
    }

    @keyframes cursor-blink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
    }

    .about {
        font-family: "Lilex";
        font-size: 0.85rem;
        font-weight: 300;
        line-height: 1.75;
        color: #F4F4F9;
        text-align: justify;
    }

  @media (max-width: 480px) {
    .about {
      text-align: left;
    }
  }

    body:not(.crt-text-off) .about {
        text-align: left;
    }

    .links {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 0.75rem;
        margin: 1.25rem 0;
    }

    .dot {
        color: #D1D1D7;
        font-size: 0.7rem;
    }

    body:not(.crt-text-off) .links {
        justify-content: flex-start;
    }

    body:not(.crt-text-off) .textLink {
        font-size: 0.85rem;
    }

    a:link, a:visited {
        color: #F4F4F9;
        text-decoration: none;
    }

    a:hover, a:active {
        color: white;
        text-decoration: underline;
    }

    .textLink {
        font-family: "Lilex";
        font-size: 0.85rem;
        font-weight: 300;
    }

    ul {
        margin: 0 auto;
        padding: 0;
        list-style-type: none;
      }
    
    li {
        font-family: "Lilex";
        font-size: 0.85rem;
        font-weight: 300;
        color: #F4F4F9;
        transition: transform 0.25s;
        text-decoration: none;
        line-height: 2;
    }

    .experience,
    .projects {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    body:not(.crt-text-off) .experience li,
    body:not(.crt-text-off) .projects li {
        position: relative;
        padding-left: 1.1em;
    }

    body:not(.crt-text-off) .experience li::before,
    body:not(.crt-text-off) .projects li::before {
        content: "❯";
        position: absolute;
        left: 0;
        color: #63727a;
    }

    .experience li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
    }

    .experience-title {
        color: #F4F4F9;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .experience-date {
        font-weight: 300;
        color: #D1D1D7;
        font-style: italic;
        flex-shrink: 0;
        white-space: nowrap;
    }

    @media (max-width: 500px) {
        .experience li {
            flex-wrap: wrap;
            align-items: baseline;
            row-gap: 2px;
        }

        .experience-title {
            display: contents;
        }

        .experience-company {
            order: 1;
            white-space: nowrap;
        }

        .experience-dash {
            display: none;
        }

        .experience-date {
            order: 2;
        }

        .experience-role {
            order: 3;
            flex-basis: 100%;
            display: block;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
    }

    .projects li a {
        display: block;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    @media (max-width: 500px) {
        .projects li a {
            white-space: normal;
            overflow: visible;
        }

        .project-name {
            display: block;
            white-space: nowrap;
        }

        .project-dash {
            display: none;
        }

        .project-desc {
            display: block;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
    }
</style>
