---
import '../globals.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<meta id="theme-color" name="theme-color" content="#000000" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		    <title>Andrew Durnford</title>
		<meta
		name="description"
		content="Computer Science & Business Student focused on Full Stack development"
		/>

		<!-- Google / Search Engine Tags -->
		<meta itemprop="name" content="Andrew Durnford" />
		<meta
		itemprop="description"
		content="Computer Science & Business Student focused on Full Stack development"
		/>
		<meta itemprop="image" content="https://andrewdurnford.com/meta.jpeg" /> 

		<!-- Facebook Meta Tags -->
		<meta property="og:url" content="https://andrewdurnford.com/" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Andrew Durnford" />
		<meta
		property="og:description"
		content="Computer Science & Business Student focused on Full Stack development"
		/>
		<meta
		property="og:image"
		content="https://andrewdurnford.com/meta.jpeg"
		/>

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Andrew Durnford" />
		<meta
		name="twitter:description"
		content="Computer Science & Business Student focused on Full Stack development"
		/>
		<meta
		name="twitter:image"
		content="https://andrewdurnford.com/meta.jpeg"
		/>
	</head>
	<body>
		<div id="crt"></div>
		<button id="toggle-crt" type="button">crt</button>
		<slot />
	</body>
</html>

<script>
	const crtEl = document.getElementById('crt') as HTMLElement;
	const crtBtn = document.getElementById('toggle-crt') as HTMLButtonElement;
	const themeColorEl = document.getElementById('theme-color') as HTMLMetaElement;

	let crtOn = localStorage.getItem('crtOn') !== 'false';

	function updateCrt() {
		crtEl.style.display = crtOn ? '' : 'none';
		document.body.classList.toggle('crt-text-off', !crtOn);
		crtBtn.classList.toggle('active', crtOn);
		crtBtn.textContent = `crt ${crtOn ? 'on' : 'off'}`;
		themeColorEl.content = crtOn ? '#000000' : '#001A23';
	}
	function updateScrollVisibility() {
		crtBtn.classList.toggle('hidden', window.scrollY > 0);
	}
	window.addEventListener('scroll', updateScrollVisibility, { passive: true });
	updateScrollVisibility();

	crtBtn.addEventListener('click', () => {
		crtOn = !crtOn;
		localStorage.setItem('crtOn', String(crtOn));
		updateCrt();
	});

	updateCrt();

	function wrapWords(root: Element) {
		const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
			acceptNode(node) {
				if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
				if ((node.parentElement as HTMLElement)?.closest('a')) return NodeFilter.FILTER_REJECT;
				return NodeFilter.FILTER_ACCEPT;
			},
		});
		const textNodes: Text[] = [];
		let n: Node | null;
		while ((n = walker.nextNode())) textNodes.push(n as Text);

		for (const node of textNodes) {
			const parts = node.nodeValue!.split(/(\s+)/);
			const frag = document.createDocumentFragment();
			for (const part of parts) {
				if (part === '') continue;
				if (/^\s+$/.test(part)) {
					frag.appendChild(document.createTextNode(part));
				} else {
					const span = document.createElement('span');
					span.className = 'word';
					span.textContent = part;
					frag.appendChild(span);
				}
			}
			node.parentNode?.replaceChild(frag, node);
		}
	}
	document.querySelectorAll('main, .links').forEach((el) => wrapWords(el));
</script>
